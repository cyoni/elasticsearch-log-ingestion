{
  "name": "homework-elastic",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "scripts": {
    "test": "jest --detectOpenHandles --runInBand",
    "dev": "pnpm --filter @homework/api dev",
    "dev:worker": "pnpm --filter @homework/worker dev",
    "start": "pnpm --filter @homework/api start",
    "start:worker": "pnpm --filter @homework/worker start",
    "build": "pnpm -r build",
    "create-index": "DOTENV_CONFIG_PATH=./.env ts-node -r dotenv/config -r tsconfig-paths/register scripts/create-index.ts",
    "load-logs": "DOTENV_CONFIG_PATH=./.env ts-node -r dotenv/config -r tsconfig-paths/register scripts/load-logs.ts"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.19.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "kafkajs": "^2.2.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^25.9.1",
    "jest": "^29.7.0",
    "pino-pretty": "^11.2.1",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  }
}
