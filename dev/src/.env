# Server
HOST=0.0.0.0
PORT=8082

# Elasticsearch (docker-compose: elasticsearch on :9200, security disabled)
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=password

# Kafka (docker-compose: kafka on :9092)
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_TOPIC_ACCESS_LOGS=access-logs-ingest
KAFKA_CLIENT_ID=homework-elastic
KAFKA_GROUP_ID=access-logs-ingest-workers
